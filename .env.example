# Sumber data: "mock" (data contoh di memori, tanpa backend) atau "api" (backend sungguhan)
DATA_SOURCE=mock

# Base URL backend API, wajib diisi jika DATA_SOURCE=api.
# Hanya dibaca di server, jadi TIDAK memakai prefix NEXT_PUBLIC_.
API_BASE_URL=http://localhost:4000/api/v1

# Batas waktu request ke API dalam milidetik
API_TIMEOUT_MS=10000
